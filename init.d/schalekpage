#!/sbin/openrc-run
# OpenRC service for schalekpage (Alpine Linux).
#
# Install: see README/instructions accompanying this file.

name="schalekpage"
description="SchalekPage EduPage dashboard"

: "${SCHALEKPAGE_BIN:=/usr/local/bin/schalekpage}"
: "${SCHALEKPAGE_USER:=schalekpage}"
: "${SCHALEKPAGE_GROUP:=schalekpage}"
: "${SCHALEKPAGE_DIR:=/var/lib/schalekpage}"
: "${SCHALEKPAGE_ADDR:=:5000}"
: "${SCHALEKPAGE_HTTPS_ADDR:=:443}"
: "${SCHALEKPAGE_DOMAIN:=}"
: "${SCHALEKPAGE_NO_CERT:=}"

command="$SCHALEKPAGE_BIN"
command_args="-addr ${SCHALEKPAGE_ADDR} -https-addr ${SCHALEKPAGE_HTTPS_ADDR} -cert-cache ${SCHALEKPAGE_DIR}/certs"
[ -n "$SCHALEKPAGE_DOMAIN" ] && command_args="$command_args -domain ${SCHALEKPAGE_DOMAIN}"
[ -n "$SCHALEKPAGE_NO_CERT" ] && command_args="$command_args -no-cert"

command_user="${SCHALEKPAGE_USER}:${SCHALEKPAGE_GROUP}"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
directory="$SCHALEKPAGE_DIR"

output_log="/var/log/schalekpage/schalekpage.log"
error_log="/var/log/schalekpage/schalekpage.log"

depend() {
	need net
	use dns
	after firewall
}

start_pre() {
	checkpath -d -o "${command_user}" -m 0750 "$SCHALEKPAGE_DIR"
	checkpath -d -o "${command_user}" -m 0750 "$SCHALEKPAGE_DIR/certs"
	checkpath -d -o "${command_user}" -m 0750 /var/log/schalekpage

	# Allow binding to privileged ports (443) without running as root.
	if command -v setcap >/dev/null 2>&1; then
		setcap 'cap_net_bind_service=+ep' "$SCHALEKPAGE_BIN" 2>/dev/null || true
	fi
}
