{
  "name": "SchalekPage",
  "short_name": "Schalek",
  "description": "Grades, timetable, lunches and substitutions from EduPage.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "portrait",
  "lang": "en",
  "icons": [
    { "src": "/static/icons/icon-48.png", "sizes": "48x48", "type": "image/png" },
    { "src": "/static/icons/icon-72.png", "sizes": "72x72", "type": "image/png" },
    { "src": "/static/icons/icon-96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "/static/icons/icon-128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "/static/icons/icon-144.png", "sizes": "144x144", "type": "image/png" },
    { "src": "/static/icons/icon-152.png", "sizes": "152x152", "type": "image/png" },
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-384.png", "sizes": "384x384", "type": "image/png" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Timetable", "url": "/timetable/", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Grades", "url": "/grades", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Lunches", "url": "/lunches/", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Substitutions", "url": "/substitutions/", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
